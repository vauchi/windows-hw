<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-FileCopyrightText: 2026 Mattia Egloff <mattia.egloff@pm.me>
SPDX-License-Identifier: GPL-3.0-or-later

The sources are stated here and nowhere else: <clear /> drops whatever the
account's own NuGet.Config holds, so every host restores from the same two
places (the windows repository's nuget.config records the runner that had
no sources at all). Vauchi.Contract comes from the contract project's
package registry, addressed by its number: 88365544 is vauchi/contract,
and the registry answers "id is invalid" to the project's path.
packageSourceMapping keeps each package on its one source, so a
same-named package on the other source is never taken.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vauchi-contract" value="https://gitlab.com/api/v4/projects/88365544/packages/nuget/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vauchi-contract">
      <package pattern="Vauchi.Contract" />
    </packageSource>
  </packageSourceMapping>
</configuration>
