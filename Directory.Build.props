<Project>
  <PropertyGroup>
    <!-- The release: merging a change of this line to main tags v<Version>
         (auto-tag:version) and the tag publishes the package. -->
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Turns on the trim and ahead-of-time analyzers: vauchi-hw-host is
         compiled ahead of time, so reflection anywhere below is an error. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The contract version every project here builds against, pinned
         exactly: an app holds one contract per binary (ADR-078 D-15). -->
    <VauchiContractVersion>0.100.0</VauchiContractVersion>
  </PropertyGroup>
</Project>
