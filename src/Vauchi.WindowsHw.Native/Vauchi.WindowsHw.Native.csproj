<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Windows backends behind the ports: WinRT Bluetooth LE,
         smart-card readers, cameras. Windows 10 2004 is the first build
         whose projection holds everything used here. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <!-- Lets the Linux container compile and pack this project against
         the Windows SDK's reference assemblies; it runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinSCard's reader-state structure holds a fixed byte array. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>vauchi-windows-hw-native</PackageId>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://gitlab.com/vauchi/windows-hw</RepositoryUrl>
    <Description>Vauchi's hardware shell for Windows: the WinRT backends behind the ports (ADR-077)</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vauchi.WindowsHw\Vauchi.WindowsHw.csproj" />
  </ItemGroup>
  <!-- The QR decoder. Its native library would land beside the
       application as ZXing.dll, where ZXing.Net's zxing.dll is (the app
       draws with ZXing.Net): the native asset is excluded, here and for
       every consumer, and shipped in a folder of its own instead, which
       ZxingCppDecoder loads from. -->
  <ItemGroup>
    <PackageReference Include="ZXingCpp" Version="[0.5.3]" ExcludeAssets="native" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgZXingCpp)\runtimes\win-x64\native\ZXing.dll"
          Link="zxing-cpp\ZXing.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Pack="true"
          PackagePath="build\zxing-cpp\ZXing.dll"
          Visible="false" />
    <None Include="build\vauchi-windows-hw-native.targets" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>
</Project>
