<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The notification port's payload. Showing a notification needs the
         Windows App SDK runtime and a desktop session; what is shown is
         tested here without either. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- No resources: the App SDK's PRI tasks, which plain dotnet build
         cannot load, have nothing to index. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vauchi.WindowsHw.Notifications\Vauchi.WindowsHw.Notifications.csproj" />
  </ItemGroup>
</Project>
