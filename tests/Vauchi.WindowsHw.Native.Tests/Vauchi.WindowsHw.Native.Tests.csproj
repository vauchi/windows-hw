<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Windows backends that run without a device: the QR decoder.
         They load native code, so they build and run on Windows only. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Draws the test codes, and is the library windows-display draws with:
         its zxing.dll and zxing-cpp's native ZXing.dll must both arrive in
         this output folder, as they arrive in the app's. -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vauchi.WindowsHw.Native\Vauchi.WindowsHw.Native.csproj" />
  </ItemGroup>
</Project>
